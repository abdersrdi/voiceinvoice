{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح Talkstamp ختم شركتك بالكاميرا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp scans your company stamp with the camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp escanea el sello de tu empresa con la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp scanne le tampon de votre entreprise avec l'appareil photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp कैमरे से आपकी कंपनी की मुहर स्कैन करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp scansiona il timbro della tua azienda con la fotocamera."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp کیمرے سے آپ کی کمپنی کی مہر اسکین کرتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 使用相机扫描你的公司印章。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع Talkstamp أثناء إملائك لبنود الفاتورة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp listens while you dictate invoice items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp escucha mientras dictas los artículos de la factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp écoute pendant que vous dictez les articles de la facture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप इनवॉइस के आइटम बोलते हैं तब Talkstamp सुनता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp ascolta mentre detti gli articoli della fattura."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ انوائس کے آئٹمز بولتے ہیں تو Talkstamp سنتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 会在你口述发票项目时收听。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل Talkstamp إملاءك إلى بنود فاتورة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp turns your dictation into invoice line items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp convierte tu dictado en líneas de factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp transforme votre dictée en lignes de facture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp आपके बोले हुए को इनवॉइस की पंक्तियों में बदलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp trasforma la tua dettatura in righe di fattura."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp آپ کے بولے ہوئے کو انوائس کی سطروں میں بدلتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 会把你的口述转换为发票项目。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
