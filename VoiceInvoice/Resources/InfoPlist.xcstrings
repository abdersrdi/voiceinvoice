{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp scans your company stamp with the camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp escanea el sello de tu empresa con la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp scanne le tampon de votre entreprise avec l'appareil photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp scansiona il timbro della tua azienda con la fotocamera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 使用相机扫描你的公司印章。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp listens while you dictate invoice items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp escucha mientras dictas los artículos de la factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp écoute pendant que vous dictez les articles de la facture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp ascolta mentre detti gli articoli della fattura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 会在你口述发票项目时收听。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp turns your dictation into invoice line items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp convierte tu dictado en líneas de factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp transforme votre dictée en lignes de facture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp trasforma la tua dettatura in righe di fattura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 会把你的口述转换为发票项目。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
