    "Add the people who dictate invoices. Enroll up to %lld voices so VoiceInvoice can tell who is speaking and note it on each invoice.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a las personas que dictan facturas. Registra hasta %lld voces para que VoiceInvoice sepa quién habla y lo anote en cada factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les personnes qui dictent des factures. Enregistrez jusqu'à %lld voix pour que VoiceInvoice sache qui parle et l'indique sur chaque facture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le persone che dettano le fatture. Registra fino a %lld voci così VoiceInvoice riconosce chi parla e lo annota su ogni fattura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加会口述发票的人员。最多登记 %lld 个声音，VoiceInvoice 就能识别说话人并记录在每张发票上。"
          }
        }
      }
    },
    "Address": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
