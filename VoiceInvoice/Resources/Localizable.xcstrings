    "“Add three coffees for twelve in total.”": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Añade tres cafés por doce en total.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ajoute trois cafés pour douze au total. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Aggiungi tre caffè per dodici in totale.»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“加三杯咖啡，一共十二块。”"
          }
        }
      }
    },
    "“One jacket at a hundred and fifty, thank you.”": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Una chaqueta a ciento cincuenta, gracias.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Une veste à cent cinquante, merci. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Una giacca a centocinquanta, grazie.»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“一件外套一百五十块，谢谢。”"
          }
        }
      }
    },
    "“Two shirts at twenty each and a pair of pants for forty.”": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Dos camisas a veinte cada una y unos pantalones por cuarenta.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Deux chemises à vingt chacune et un pantalon pour quarante. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Due camicie a venti l'una e un paio di pantaloni a quaranta.»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“两件衬衫每件二十块，一条裤子四十块。”"
          }
        }
      }
    }
  },
