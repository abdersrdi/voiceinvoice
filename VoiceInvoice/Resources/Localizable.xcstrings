    "Speech recognition is not available for this language right now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعرف على الكلام غير متاح لهذه اللغة حاليًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz no está disponible para este idioma ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale n'est pas disponible pour cette langue pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस भाषा के लिए स्पीच रिकग्निशन अभी उपलब्ध नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale non è disponibile per questa lingua al momento."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس زبان کے لیے اسپیچ ریکگنیشن اس وقت دستیاب نہیں ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法对该语言进行语音识别。"
          }
        }
      }
    },
    "Speech recognition is turned off for Talkstamp. You can enable it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعرف على الكلام متوقف لتطبيق Talkstamp. يمكنك تفعيله من الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para Talkstamp. Puedes activarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour Talkstamp. Vous pouvez l'activer dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp के लिए स्पीच रिकग्निशन बंद है। आप इसे सेटिंग्स में चालू कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per Talkstamp. Puoi attivarlo in Impostazioni."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp کے لیے اسپیچ ریکگنیشن بند ہے۔ آپ اسے سیٹنگز میں آن کر سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 的语音识别权限已关闭，可在“设置”中开启。"
          }
        }
      }
    },
