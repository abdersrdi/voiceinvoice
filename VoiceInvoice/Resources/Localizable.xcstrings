    "Move right to keep faint ink. Move left to remove paper noise and shadows.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve a la derecha para conservar la tinta tenue. Mueve a la izquierda para quitar el ruido y las sombras del papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez à droite pour garder l'encre claire. Déplacez à gauche pour retirer le bruit et les ombres du papier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta a destra per mantenere l'inchiostro tenue. Sposta a sinistra per eliminare disturbi e ombre della carta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右拖动可保留淡墨迹，向左拖动可去除纸张噪点和阴影。"
