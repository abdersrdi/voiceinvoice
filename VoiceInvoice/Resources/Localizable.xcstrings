    "Everything you already made stays free to view, export and share": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما أنشأته سابقًا يبقى مجانيًا للعرض والتصدير والمشاركة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que ya creaste sigue siendo gratis para ver, exportar y compartir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez déjà créé reste gratuit à consulter, exporter et partager"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ आप पहले बना चुके हैं वह देखने, निर्यात करने और साझा करने के लिए मुफ़्त रहेगा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che hai già creato resta gratuito da consultare, esportare e condividere"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو کچھ آپ پہلے بنا چکے ہیں وہ دیکھنے، برآمد کرنے اور شیئر کرنے کے لیے مفت رہے گا"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建的内容始终可免费查看、导出和分享"
          }
        }
      }
    },
