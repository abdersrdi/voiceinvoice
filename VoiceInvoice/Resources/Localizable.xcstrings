    "VoiceInvoice will learn the voice of %@ from three short readings, so it can tell who is dictating.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInvoice aprenderá la voz de %@ con tres lecturas cortas para saber quién está dictando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInvoice apprendra la voix de %@ à partir de trois courtes lectures afin de reconnaître qui dicte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInvoice imparerà la voce di %@ da tre brevi letture, così saprà chi sta dettando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceInvoice 将通过三次简短朗读学习%@的声音，以便识别谁在口述。"
          }
        }
      }
    },
    "We didn't hear enough. Move closer, speak a little louder and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No oímos lo suficiente. Acércate, habla un poco más alto e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas assez entendu. Rapprochez-vous, parlez un peu plus fort et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo sentito abbastanza. Avvicinati, parla un po' più forte e riprova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没听清。请靠近一些，稍微大声一点再试一次。"
          }
        }
      }
    },
