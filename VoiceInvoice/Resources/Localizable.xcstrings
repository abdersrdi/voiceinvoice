          }
        }
      }
    },
    "You've used your %lld free invoices this month.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استخدمت فواتيرك المجانية البالغة %lld هذا الشهر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado tus %lld facturas gratuitas de este mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé vos %lld factures gratuites ce mois-ci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इस महीने के अपने %lld मुफ़्त इनवॉइस इस्तेमाल कर लिए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai usato le tue %lld fatture gratuite di questo mese."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اس مہینے کی اپنی %lld مفت انوائسز استعمال کر لی ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你本月的 %lld 张免费发票已用完。"
          }
        }
      }
    },
    "Your invoices stay on your devices and sync through your own iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى فواتيرك على أجهزتك وتتم مزامنتها عبر iCloud الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus facturas se quedan en tus dispositivos y se sincronizan con tu propio iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos factures restent sur vos appareils et se synchronisent via votre propre iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके इनवॉइस आपके डिवाइसों पर रहते हैं और आपके अपने iCloud से सिंक होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue fatture restano sui tuoi dispositivi e si sincronizzano tramite il tuo iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی انوائسز آپ کے آلات پر رہتی ہیں اور آپ کے اپنے iCloud کے ذریعے سنک ہوتی ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的发票保存在你的设备上，并通过你自己的 iCloud 同步。"
          }
        }
      }
    },
    "e.g. Maison Dupont": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: مؤسسة الأمل"
          }
        },
