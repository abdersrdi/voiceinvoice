    "Add the people who dictate invoices. Enroll up to %lld voices so Talkstamp can tell who is speaking and note it on each invoice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الأشخاص الذين يُملون الفواتير. سجّل ما يصل إلى %lld أصوات ليتعرف Talkstamp على المتحدث ويذكره في كل فاتورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a las personas que dictan facturas. Registra hasta %lld voces para que Talkstamp sepa quién habla y lo anote en cada factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les personnes qui dictent des factures. Enregistrez jusqu'à %lld voix pour que Talkstamp sache qui parle et l'indique sur chaque facture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन लोगों को जोड़ें जो इनवॉइस बोलते हैं। अधिकतम %lld आवाज़ें दर्ज करें ताकि Talkstamp पहचान सके कि कौन बोल रहा है और हर इनवॉइस पर उसका नाम लिख सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le persone che dettano le fatture. Registra fino a %lld voci così Talkstamp riconosce chi parla e lo annota su ogni fattura."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان لوگوں کو شامل کریں جو انوائس بولتے ہیں۔ زیادہ سے زیادہ %lld آوازیں درج کریں تاکہ Talkstamp پہچان سکے کہ کون بول رہا ہے اور ہر انوائس پر اس کا نام لکھ سکے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加会口述发票的人员。最多登记 %lld 个声音，Talkstamp 就能识别说话人并记录在每张发票上。"
          }
        }
      }
    },
