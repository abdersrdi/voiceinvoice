    "“Add three coffees for twelve in total.”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«أضف ثلاثة أكواب قهوة بإجمالي اثني عشر.»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Añade tres cafés por doce en total.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ajoute trois cafés pour douze au total. »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“तीन कॉफ़ी जोड़ें, कुल बारह की।”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Aggiungi tre caffè per dodici in totale.»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“تین کافیاں شامل کریں، کل بارہ کی۔”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“加三杯咖啡，一共十二块。”"
          }
        }
      }
    },
    "“One jacket at a hundred and fifty, thank you.”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«سترة واحدة بمئة وخمسين، شكرًا.»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Una chaqueta a ciento cincuenta, gracias.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Une veste à cent cinquante, merci. »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“एक जैकेट एक सौ पचास की, धन्यवाद।”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Una giacca a centocinquanta, grazie.»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“ایک جیکٹ ایک سو پچاس کی، شکریہ۔”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“一件外套一百五十块，谢谢。”"
          }
        }
      }
    },
    "“Two shirts at twenty each and a pair of pants for forty.”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«قميصان بعشرين للواحد وبنطال بأربعين.»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Dos camisas a veinte cada una y unos pantalones por cuarenta.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Deux chemises à vingt chacune et un pantalon pour quarante. »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“दो शर्ट बीस-बीस के और एक पैंट चालीस की।”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Due camicie a venti l'una e un paio di pantaloni a quaranta.»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“دو شرٹیں بیس بیس کی اور ایک پتلون چالیس کی۔”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“两件衬衫每件二十块，一条裤子四十块。”"
          }
        }
      }
    }
  },
  "version": "1.0"
}
