          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将声音同步到我的其他设备"
          }
        }
      }
    },
    "Syncs across your devices through your own iCloud": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم المزامنة بين أجهزتك عبر iCloud الخاص بك"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
