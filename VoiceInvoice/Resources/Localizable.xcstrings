    "Your invoices stay on your devices and sync through your own iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus facturas se quedan en tus dispositivos y se sincronizan con tu propio iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos factures restent sur vos appareils et se synchronisent via votre propre iCloud."
