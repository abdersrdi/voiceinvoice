    "A shop can enroll up to %lld voices. Delete one to enroll another.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لكل متجر تسجيل ما يصل إلى %lld أصوات. احذف صوتًا لتسجيل صوت آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comercio puede registrar hasta %lld voces. Elimina una para registrar otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commerce peut enregistrer jusqu'à %lld voix. Supprimez-en une pour en enregistrer une autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक दुकान में अधिकतम %lld आवाज़ें दर्ज की जा सकती हैं। नई आवाज़ दर्ज करने के लिए पहले एक हटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un negozio può registrare fino a %lld voci. Eliminane una per registrarne un'altra."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک دکان میں زیادہ سے زیادہ %lld آوازیں درج کی جا سکتی ہیں۔ نئی آواز درج کرنے کے لیے پہلے ایک حذف کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每家店最多可登记 %lld 个声音。请先删除一个再登记新的。"
          }
        }
      }
    },
    "A voiceprint is not a security lock. It only helps label who dictated an invoice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بصمة الصوت ليست قفل أمان. هي فقط تساعد على تسمية من أملى الفاتورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una huella de voz no es un cierre de seguridad. Solo ayuda a indicar quién dictó una factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une empreinte vocale n'est pas un verrou de sécurité. Elle sert uniquement à indiquer qui a dicté une facture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइसप्रिंट कोई सुरक्षा ताला नहीं है। यह सिर्फ़ यह बताने में मदद करता है कि इनवॉइस किसने बोला।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'impronta vocale non è un blocco di sicurezza. Serve solo a indicare chi ha dettato una fattura."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وائس پرنٹ کوئی حفاظتی تالا نہیں ہے۔ یہ صرف یہ بتانے میں مدد کرتا ہے کہ انوائس کس نے بولی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声纹不是安全锁，只用于标注是谁口述了发票。"
          }
        }
      }
    },
