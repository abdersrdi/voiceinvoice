    "Talkstamp will learn the voice of %@ from three short readings, so it can tell who is dictating.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتعرف Talkstamp على صوت %@ من ثلاث قراءات قصيرة ليعرف من يُملي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp aprenderá la voz de %@ con tres lecturas cortas para saber quién está dictando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp apprendra la voix de %@ à partir de trois courtes lectures afin de reconnaître qui dicte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp तीन छोटे पाठों से %@ की आवाज़ सीखेगा, ताकि वह पहचान सके कि कौन बोल रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp imparerà la voce di %@ da tre brevi letture, così saprà chi sta dettando."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp تین مختصر قراتوں سے %@ کی آواز سیکھے گا تاکہ وہ پہچان سکے کہ کون بول رہا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Talkstamp 将通过三次简短朗读学习%@的声音，以便识别谁在口述。"
          }
        }
      }
    },
    "Tap + to create your first invoice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط + لإنشاء أول فاتورة لك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca + para crear tu primera factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez + pour créer votre première facture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पहला इनवॉइस बनाने के लिए + दबाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + per creare la tua prima fattura."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی پہلی انوائس بنانے کے لیے + دبائیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 + 创建你的第一张发票。"
          }
        }
      }
    },
    "Tap the mic, or type here": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الميكروفون أو اكتب هنا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el micrófono o escribe aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le micro ou saisissez ici"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक दबाएँ या यहाँ टाइप करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il microfono o scrivi qui"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیک دبائیں یا یہاں ٹائپ کریں"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按麦克风，或在此输入"
          }
        }
      }
    },
    "Tap the mic, then read the sentence aloud.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الميكروفون ثم اقرأ الجملة بصوت عالٍ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el micrófono y lee la frase en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le micro, puis lisez la phrase à voix haute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक दबाएँ, फिर वाक्य ज़ोर से पढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il microfono e leggi la frase ad alta voce."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیک دبائیں، پھر جملہ بلند آواز سے پڑھیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按麦克风，然后大声朗读这句话。"
          }
        }
      }
    },
