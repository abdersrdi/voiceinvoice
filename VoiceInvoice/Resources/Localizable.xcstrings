    "Enrollment did not work. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح التسجيل. يرجى المحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro no funcionó. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a échoué. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
