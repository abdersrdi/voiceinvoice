    "Say something like: “Two shirts at 20 each and a pair of pants for 40.”": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل شيئًا مثل: «قميصان بسعر 20 للواحد وبنطال بسعر 40.»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di algo como: «Dos camisas a 20 cada una y unos pantalones por 40.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites par exemple : « Deux chemises à 20 chacune et un pantalon pour 40. »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ ऐसा बोलें: “दो शर्ट 20-20 के और एक पैंट 40 की।”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' qualcosa come: «Due camicie a 20 l'una e un paio di pantaloni a 40.»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ ایسا بولیں: “دو شرٹیں 20-20 کی اور ایک پتلون 40 کی۔”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试着说：“两件衬衫每件20块，一条裤子40块。”"
          }
        }
      }
    },
