    "Sync voice to my other devices": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة الصوت مع أجهزتي الأخرى"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar la voz con mis otros dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser la voix sur mes autres appareils"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ को मेरे अन्य डिवाइसों से सिंक करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza la voce sugli altri dispositivi"
          }
        },
        "ur": {
          "stringUnit": {
