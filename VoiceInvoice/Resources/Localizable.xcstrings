          }
        }
      }
    },
    "After you stop, phrases that do not sound like the speaker are left out, and you can bring them back. Needs an enrolled voice.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar, se omiten las frases que no suenan como el hablante y puedes recuperarlas. Requiere una voz registrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l'arrêt, les phrases qui ne ressemblent pas à la voix du locuteur sont écartées, et vous pouvez les rétablir. Nécessite une voix enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando smetti, le frasi che non assomigliano alla voce di chi parla vengono escluse e puoi recuperarle. Richiede una voce registrata."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止后，听起来不像说话人的语句会被排除，你可以将其恢复。需要已登记的声音。"
          }
        }
      }
    },
