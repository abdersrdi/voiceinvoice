    "A shop can enroll up to %lld voices. Delete one to enroll another.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comercio puede registrar hasta %lld voces. Elimina una para registrar otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commerce peut enregistrer jusqu'à %lld voix. Supprimez-en une pour en enregistrer une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un negozio può registrare fino a %lld voci. Eliminane una per registrarne un'altra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每家店最多可登记 %lld 个声音。请先删除一个再登记新的。"
          }
        }
      }
    },
    "A voiceprint is not a security lock. It only helps label who dictated an invoice.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una huella de voz no es un cierre de seguridad. Solo ayuda a indicar quién dictó una factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une empreinte vocale n'est pas un verrou de sécurité. Elle sert uniquement à indiquer qui a dicté une facture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'impronta vocale non è un blocco di sicurezza. Serve solo a indicare chi ha dettato una fattura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声纹不是安全锁，只用于标注是谁口述了发票。"
          }
        }
      }
    },
