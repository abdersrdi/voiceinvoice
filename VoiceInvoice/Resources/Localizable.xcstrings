    "We didn't hear enough. Move closer, speak a little louder and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نسمع بما يكفي. اقترب وتحدّث بصوت أعلى قليلًا وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No oímos lo suficiente. Acércate, habla un poco más alto e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas assez entendu. Rapprochez-vous, parlez un peu plus fort et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने पर्याप्त नहीं सुना। पास आएँ, थोड़ा ज़ोर से बोलें और फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo sentito abbastanza. Avvicinati, parla un po' più forte e riprova."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے کافی نہیں سنا۔ قریب آئیں، ذرا بلند آواز سے بولیں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没听清。请靠近一些，稍微大声一点再试一次。"
          }
        }
      }
    },
    "What I heard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما سمعته"
          }
