    "Start dictating a new invoice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ إملاء فاتورة جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a dictar una factura nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à dicter une nouvelle facture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया इनवॉइस बोलना शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a dettare una nuova fattura."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی انوائس بولنا شروع کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始口述一张新发票。"
          }
        }
      }
    },
