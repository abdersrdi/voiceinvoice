    "Today's invoiced total. Tap to dictate a new invoice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجمالي فواتير اليوم. اضغط لإملاء فاتورة جديدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Total facturado hoy. Toca para dictar una factura nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Total facturé aujourd'hui. Touchez pour dicter une nouvelle facture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के इनवॉइस का कुल। नया इनवॉइस बोलने के लिए टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Totale fatturato oggi. Tocca per dettare una nuova fattura."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی انوائسز کا کل۔ نئی انوائس بولنے کے لیے ٹیپ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日开票总额。点按即可口述新发票。"
          }
        }
      }
    }
